{
  "display_name": "Claude Code Worker",
  "command": [
    "python",
    "examples/claude_code_adapter.py",
    "--mode",
    "exec",
    "--cwd",
    "S:/portable-vibe-agent-demo",
    "--output-format",
    "json",
    "--permission-mode",
    "default"
  ],
  "working_dir": ".",
  "timeout_seconds": 600,
  "route_by_default": true,
  "capabilities": [
    "local.agent",
    "claude.exec",
    "repo.read",
    "repo.write",
    "test.run",
    "git.status"
  ]
}
