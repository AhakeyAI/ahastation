# Placeholders only. Replace in the Weixin cloud service settings, not source ZIP.
PORT=8787
WEB_CONCURRENCY=1
MYSQL_HOST=replace-with-internal-host
MYSQL_PORT=3306
MYSQL_DATABASE=station_hub
MYSQL_USER=station_hub_app
MYSQL_PASSWORD=replace-with-database-password
# Optional provider CA path mounted/configured by operator; verification cannot be disabled here.
# MYSQL_SSL_CA=/run/secrets/mysql-ca.pem
HUB_SECRET=replace-with-at-least-32-random-characters
HUB_FEEDBACK_DAYS=7
HUB_MAINTENANCE=0
BRIDGE_DOWNLOAD_URL=
# MYSQL_ADDRESS and MYSQL_USERNAME from the Weixin MySQL panel are also supported.
# Never set POCKET_VIBE_TOKEN or POCKET_VIBE_TOOL_TOKEN for the public service.
